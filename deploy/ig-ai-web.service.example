[Unit]
Description=IG AI localhost web/PWA viewer
After=network-online.target ig-ai.service
Wants=network-online.target

[Service]
Type=simple
User=igai
Group=igai
WorkingDirectory=/opt/ig-ai
EnvironmentFile=/etc/ig-ai/ig-ai-web.env
ExecStart=/opt/ig-ai/.venv/bin/ig-ai-web
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal
UMask=0077
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/ig-ai
PrivateTmp=true

[Install]
WantedBy=multi-user.target
