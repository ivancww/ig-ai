#!/usr/bin/env bash
set -euo pipefail

# Local-only readiness check. It never creates cloud resources and never
# prints environment values or credentials.
service_name="${IGAI_SERVICE_NAME:-ig-ai}"
web_service_name="${IGAI_WEB_SERVICE_NAME:-ig-ai-web}"
web_host="${IGAI_WEB_HOST:-127.0.0.1}"
web_port="${IGAI_WEB_PORT:-8080}"
database_path="${IG_DATABASE_PATH:-/var/lib/ig-ai/data/ig_ai.sqlite3}"
heartbeat_seconds="${IGAI_SERVICE_HEARTBEAT_SECONDS:-30}"
stale_data_seconds="${IGAI_STALE_DATA_SECONDS:-900}"
web_url="http://${web_host}:${web_port}"

case "$web_host" in
  127.0.0.1|localhost|::1) ;;
  *) echo "FAIL: web host must remain loopback" >&2; exit 1 ;;
esac

systemctl is-active --quiet "$service_name" || { echo "FAIL: backend service is not active" >&2; exit 1; }
systemctl is-active --quiet "$web_service_name" || { echo "FAIL: web service is not active" >&2; exit 1; }
test -r "$database_path" || { echo "FAIL: persistent database is not readable" >&2; exit 1; }

python3 - "$database_path" <<'PY'
import sqlite3
import sys

path = sys.argv[1]
connection = sqlite3.connect(f"file:{path}?mode=ro", uri=True)
connection.execute("SELECT 1")
connection.close()
print("database: accessible (read-only check)")
PY

health="$(curl --fail --silent --show-error --max-time 5 "$web_url/api/health")"
curl --fail --silent --show-error --max-time 5 "$web_url/api/dashboard" >/dev/null
health_file="$(mktemp)"
trap 'rm -f "$health_file"' EXIT
printf '%s' "$health" > "$health_file"
python3 - "$heartbeat_seconds" "$stale_data_seconds" "$health_file" <<'PY'
import json
import sys
from datetime import UTC, datetime

heartbeat_seconds = float(sys.argv[1])
stale_data_seconds = float(sys.argv[2])
payload = json.load(open(sys.argv[3], encoding="utf-8"))
service = payload.get("service", {})
markets = payload.get("markets", [])
heartbeat = service.get("last_heartbeat")
if not heartbeat:
    raise SystemExit("FAIL: heartbeat is unavailable")
try:
    age = (datetime.now(UTC) - datetime.fromisoformat(heartbeat).astimezone(UTC)).total_seconds()
except ValueError as exc:
    raise SystemExit("FAIL: heartbeat timestamp is invalid") from exc
if age > heartbeat_seconds * 3:
    raise SystemExit("FAIL: heartbeat is stale")
contract = payload.get("health_contract", {})
if contract.get("heartbeat_max_age_seconds") != heartbeat_seconds * 3:
    raise SystemExit("FAIL: health contract heartbeat threshold mismatch")
if contract.get("stale_data_seconds") != stale_data_seconds:
    raise SystemExit("FAIL: health contract stale-data threshold mismatch")
if payload.get("overall_status") not in {"HEALTHY", "ATTENTION"}:
    raise SystemExit("FAIL: overall health is not ready")
critical = [
    item for item in payload.get("incidents", [])
    if item.get("status", "ACTIVE") == "ACTIVE"
    and item.get("severity") in {"DEGRADED", "CRITICAL"}
]
if critical:
    raise SystemExit("FAIL: active service/IG readiness incident")
generation = service.get("runtime_generation")
self_monitoring = payload.get("self_monitoring", {})
if generation and (self_monitoring.get("runtime_generation") != generation or not self_monitoring.get("ready")):
    raise SystemExit("FAIL: self-monitor snapshot is not from the current runtime generation")
if generation and not service.get("service_started_at"):
    raise SystemExit("FAIL: current service generation is missing its start marker")
if len(markets) < 3:
    raise SystemExit("FAIL: fewer than three monitored markets are visible")
if generation and self_monitoring.get("generated_at"):
    try:
        generated = datetime.fromisoformat(self_monitoring["generated_at"]).astimezone(UTC)
    except ValueError as exc:
        raise SystemExit("FAIL: self-monitor timestamp is invalid") from exc
    if generated < datetime.fromisoformat(service["service_started_at"]).astimezone(UTC):
        raise SystemExit("FAIL: self-monitor snapshot predates the current generation")
print("backend status: " + str(service.get("status", "UNKNOWN")))
print("IG connection: " + str(service.get("ig_connection", "UNKNOWN")))
print("monitored markets visible: " + str(len(markets)))
print("dashboard API: reachable on loopback")
PY
