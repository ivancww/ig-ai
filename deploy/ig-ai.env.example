# Copy to /etc/ig-ai/ig-ai.env, chmod 600, and supply secrets outside Git.
# This file must remain outside the repository and must never be logged.
IG_API_KEY=
IG_USERNAME=
IG_PASSWORD=
IG_ACCOUNT_TYPE=DEMO
IG_DATABASE_PATH=/var/lib/ig-ai/data/ig_ai.sqlite3
IGAI_STATE_DIR=/var/lib/ig-ai/state
IGAI_REPORT_PATH=/var/lib/ig-ai/state/igai-report.txt
IG_STREAM_RECONNECT_SECONDS=5
IGAI_SERVICE_HEARTBEAT_SECONDS=30
IGAI_STALE_DATA_SECONDS=900
IGAI_MARKET_STATUS_REFRESH_SECONDS=300
IGAI_MONITORING_MODE=24_7
IGAI_TIMEZONE=UTC
# Required for CUSTOM. Semicolon-separated: DAYS HH:MM-HH:MM
# IGAI_CUSTOM_WINDOWS=1,2,3,4,5 20:00-05:00
# MARKET_HOURS intentionally remains UNKNOWN until verified session rules exist.
